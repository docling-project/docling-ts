{
  "include": ["src"],
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "lib": ["es2022", "dom"],
    "declaration": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "dist",
    "rootDir": "src"
  }
}
