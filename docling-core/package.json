{
  "name": "@docling/docling-core",
  "version": "2.106.0",
  "description": "TypeScript definitions and functions for using Docling output.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "doclang": [
        "./dist/doclang/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./doclang": {
      "import": {
        "types": "./dist/doclang/index.d.ts",
        "default": "./dist/doclang/index.js"
      },
      "require": {
        "types": "./dist/doclang/index.d.cts",
        "default": "./dist/doclang/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "publint": "publint",
    "attw": "attw --pack .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run publint && npm run attw"
  },
  "keywords": [
    "html",
    "markdown",
    "pdf",
    "ai",
    "convert",
    "xlsx",
    "pdf-converter",
    "docx",
    "documents",
    "pptx",
    "pdf-to-text",
    "tables",
    "document-parser",
    "pdf-to-json",
    "document-parsing"
  ],
  "contributors": [
    "Cesar Berrospi Ramis <ceb@zurich.ibm.com>",
    "Valery Weber <vwe@zurich.ibm.com>",
    "Peter Staar <taa@zurich.ibm.com>",
    "Christoph Auer <cau@zurich.ibm.com>",
    "Tiago Santana <tiago.santana@ibm.com>",
    "Michele Dolfi <dol@zurich.ibm.com>",
    "Kasper Dinkla <dkl@zurich.ibm.com>",
    "Rafael Teixeira de Lima <rtdl@ibm.com>",
    "Panos Vagenas <pva@zurich.ibm.com>"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docling-project/docling-ts.git"
  },
  "bugs": {
    "url": "https://github.com/docling-project/docling-ts/issues"
  },
  "homepage": "https://github.com/docling-project/docling-ts/tree/main/docling-core",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "10.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "publint": "^0.3.24",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@xmldom/xmldom": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": {
      "optional": true
    }
  }
}
